From 86b7ce854d8e75a0c7e946d0a7cb7d537c5c8062 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 18:31:36 +0000
Subject: [PATCH 2/3] fix(game): make GameController.fromFen return a Result

GameController.fromFen used GameState.fromFen(fen).valueOrNull and fell
back to the standard starting position whenever parsing failed, so an
invalid FEN silently became a brand new game.

fromFen is now a static method returning
Result<GameController, ChessEngineError>. The engine's own error
(InvalidFenError or InvalidChessPositionError) is passed through
unchanged and no controller is created for a rejected FEN. Valid FENs
behave as before. fromFen had no callers in the repository.

Adds test/game/game_controller_test.dart covering a valid FEN, the
starting position, an already finished position, malformed text, an
impossible board, and that the engine error is not altered.
---
 lib/game/game_controller.dart       |  9 ++--
 test/game/game_controller_test.dart | 79 +++++++++++++++++++++++++++++
 2 files changed, 83 insertions(+), 5 deletions(-)
 create mode 100644 test/game/game_controller_test.dart

diff --git a/lib/game/game_controller.dart b/lib/game/game_controller.dart
index 0337af3..8eba5f9 100644
--- a/lib/game/game_controller.dart
+++ b/lib/game/game_controller.dart
@@ -23,11 +23,10 @@ class GameController extends ChangeNotifier {
     _legalMoves = _gameState.legalMoves;
   }
 
-  /// Convenience for starting from a specific position (tests, and later
-  /// features like loading a saved game or a puzzle). Falls back to the
-  /// normal starting position if [fen] fails to parse.
-  factory GameController.fromFen(String fen) {
-    return GameController(initialState: GameState.fromFen(fen).valueOrNull);
+  static Result<GameController, ChessEngineError> fromFen(String fen) {
+    final parsed = GameState.fromFen(fen);
+    if (parsed.isErr) return Result.err(parsed.errorOrNull!);
+    return Result.ok(GameController(initialState: parsed.valueOrNull!));
   }
 
   GameState _gameState;
diff --git a/test/game/game_controller_test.dart b/test/game/game_controller_test.dart
new file mode 100644
index 0000000..5ea2216
--- /dev/null
+++ b/test/game/game_controller_test.dart
@@ -0,0 +1,79 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:grand_chess/chess_engine/chess_engine.dart';
+import 'package:grand_chess/game/game_controller.dart';
+import 'package:grand_chess/game/game_outcome.dart';
+
+void main() {
+  const codec = FenCodec();
+  const blackToMoveFen =
+      'rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR b KQkq - 0 1';
+  const foolsMateFen =
+      'rnb1kbnr/pppp1ppp/8/4p3/6Pq/5P2/PPPPP2P/RNBQKBNR w KQkq - 1 3';
+  const malformedFen = 'not a fen at all';
+  const noWhiteKingFen = '4k3/8/8/8/8/8/8/8 w - - 0 1';
+
+  GameController acceptedController(String fen) {
+    final result = GameController.fromFen(fen);
+    expect(result.isOk, isTrue, reason: 'expected "$fen" to be accepted');
+    final controller = result.valueOrNull!;
+    addTearDown(controller.dispose);
+    return controller;
+  }
+
+  group('GameController.fromFen with a valid FEN', () {
+    test('starts on exactly the position that was given', () {
+      final controller = acceptedController(blackToMoveFen);
+
+      final fen = codec.toFen(controller.gameState.position);
+      expect(fen, blackToMoveFen);
+      expect(controller.gameState.moveHistory, isEmpty);
+    });
+
+    test('still accepts the standard starting position', () {
+      final controller = acceptedController(FenCodec.startingPositionFen);
+
+      final fen = codec.toFen(controller.gameState.position);
+      expect(fen, FenCodec.startingPositionFen);
+      expect(controller.isGameOver, isFalse);
+      expect(controller.selectedSquare, isNull);
+    });
+
+    test('reports the outcome when the position is already finished', () {
+      final controller = acceptedController(foolsMateFen);
+
+      expect(controller.isGameOver, isTrue);
+      expect(controller.outcome?.reason, GameEndReason.checkmate);
+      expect(controller.outcome?.result, GameResult.blackWins);
+    });
+  });
+
+  group('GameController.fromFen with an invalid FEN', () {
+    test('returns InvalidFenError for malformed text', () {
+      final result = GameController.fromFen(malformedFen);
+
+      expect(result.isErr, isTrue);
+      expect(result.errorOrNull, isA<InvalidFenError>());
+      expect(result.valueOrNull, isNull);
+    });
+
+    test('returns InvalidChessPositionError for an impossible board', () {
+      final result = GameController.fromFen(noWhiteKingFen);
+
+      expect(result.isErr, isTrue);
+      expect(result.errorOrNull, isA<InvalidChessPositionError>());
+      expect(result.valueOrNull, isNull);
+    });
+
+    test('reports the same error the engine reports', () {
+      for (final fen in [malformedFen, noWhiteKingFen]) {
+        final fromController = GameController.fromFen(fen).errorOrNull;
+        final fromEngine = GameState.fromFen(fen).errorOrNull;
+
+        expect(fromController, isNotNull);
+        expect(fromEngine, isNotNull);
+        expect(fromController!.runtimeType, fromEngine!.runtimeType);
+        expect(fromController.message, fromEngine.message);
+      }
+    });
+  });
+}
